# Local development settings.
# Copy this file to .env (PowerShell: Copy-Item .env.example .env).
# .env is git-ignored, so never commit it.
#
# Debug is OFF unless you turn it on. This turns it on for your machine only.
DJANGO_DEBUG=1

# Optional in development (an insecure built-in key is used if omitted):
# DJANGO_SECRET_KEY=
# DEVICE_API_KEY=

# Uncomment to use Postgres locally instead of SQLite:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/rathinam

# ---------------------------------------------------------------
# PRODUCTION (Railway / Render): set these in the host's dashboard,
# NOT in a file. The app refuses to start without the first three
# when DJANGO_DEBUG is 0 (the default).
#   DJANGO_SECRET_KEY=<long random string>
#   DEVICE_API_KEY=<long random string>
#   DJANGO_ALLOWED_HOSTS=your-api.up.railway.app
#   DJANGO_CORS_ORIGINS=https://your-frontend.vercel.app
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://your-api.up.railway.app

SENTRY_DSN=  # paste your Sentry DSN here to enable error tracking
