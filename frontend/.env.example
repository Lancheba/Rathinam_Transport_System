# Copy to .env.production (or set these as Vercel Project → Settings → Environment
# Variables) before building for a split deployment, where the frontend (Vercel) and
# backend (Railway) are on different domains.
#
# Leave unset for local dev: `npm run dev` proxies /api to http://127.0.0.1:8000
# (see vite.config.ts), and a same-origin `npm run build` served by Django also
# works with no value here.

VITE_API_BASE_URL=https://YOUR-BACKEND.up.railway.app/api
