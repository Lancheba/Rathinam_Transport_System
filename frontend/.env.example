# Frontend environment variables (Vite).
#
# The React app is hosted on Vercel and the Django API on Railway, so they live on
# different domains. Set this in Vercel -> Project -> Settings -> Environment Variables
# (or copy this file to .env.production for a local production build).
#
# Leave it unset for local development: `npm run dev` proxies /api to
# http://127.0.0.1:8000 (see vite.config.ts).

VITE_API_BASE_URL=https://YOUR-BACKEND.up.railway.app/api